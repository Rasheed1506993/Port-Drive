# ========================================================
# Cloud Portfolio Vault - Environment Configuration Template
# إعدادات منصة المحافظ الرقمية والتخزين السحابي (قالب للنشر)
# ========================================================

# Base Application URL (Replace with your Vercel deployment URL, e.g. https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Remote Database Connection String
DATABASE_URL="postgresql://user:password@db.example.com:5432/dbname?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://user:password@db.example.com:5432/dbname?schema=public&sslmode=prefer"

# JWT Secret for Session & PIN Verification (At least 32 characters)
JWT_SECRET="generate_a_secure_random_string_for_jwt_2026"

# Admin Master Password for Dashboard Login
ADMIN_PASSWORD="YourStrongAdminPassword2026"

# ========================================================
# Cloud Storage Provider Configuration (MinIO / S3 / Cloudflare R2)
# ========================================================
# "s3" connects to MinIO / AWS S3 / Cloudflare R2 / Wasabi
# "local" saves to disk (development only)
STORAGE_DRIVER="s3"

# S3 Compatible Endpoint (e.g., https://s3.xpertsafe.com or https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
S3_ENDPOINT="https://s3.xpertsafe.com"

# S3 Region ('us-east-1', 'auto', etc.)
S3_REGION="us-east-1"

# S3 Bucket Name
S3_BUCKET="drive-assets"
S3_BUCKET_NAME="drive-assets"

# S3 Access Credentials
S3_ACCESS_KEY_ID="your_access_key_id"
S3_SECRET_ACCESS_KEY="your_secret_access_key"

# Public Access / Custom Domain URL (Optional)
S3_PUBLIC_DOMAIN=""
S3_PUBLIC_URL=""

# Force Path Style (true for MinIO / LocalStack; false for AWS S3 / Cloudflare R2)
S3_FORCE_PATH_STYLE="true"
